                     , aeson ^>= 2.2
                     , monk:monk-test-support
                     , monk:monk-bakeoff-lib
                     , bytestring ^>= 0.12
                     , containers >= 0.7 && < 0.9
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , process ^>= 1.6
                     , tasty ^>= 1.5
                     , temporary ^>= 1.3
                     , tasty-hunit ^>= 0.10
                     , tasty-quickcheck ^>= 0.11
                     , time >= 1.14 && < 1.16
                     , QuickCheck >= 2.14 && < 2.17

