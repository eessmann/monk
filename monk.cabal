  import:              common-options
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       monk
                     , optparse-applicative ^>= 0.19
                     , containers >= 0.7 && < 0.9
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
                     , text ^>= 2.1
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N

executable monk-bakeoff
  import:              common-options
  hs-source-dirs:      tooling/app/bakeoff
  main-is:             Main.hs
  build-depends:       monk
                     , monk:monk-bakeoff-lib
                     , optparse-applicative ^>= 0.19
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , time >= 1.14 && < 1.16
  ghc-options:         -threaded
                       -rtsopts
