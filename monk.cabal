cabal-version:       3.14
name:                monk
version:             0.4.0
synopsis:            Side-project Bash-to-fish translator.
description:
    Monk is a Haskell project for translating Bash scripts into fish.
    It admits an exact core under a versioned execution contract and rejects
    unsupported semantics before producing executable output. See [README.md](https://github.com/eessmann/monk#monk)
    for more details.
homepage:            https://github.com/eessmann/monk
bug-reports:         https://github.com/eessmann/monk/issues
license:             MIT
license-file:        LICENSE
author:              Erich Essmann
maintainer:          Erich Essmann <essmanne@gmail.com>
copyright:           2025 Erich Essmann
category:            Translate Bash to Fish shell
build-type:          Simple
extra-doc-files:     README.md
                     CHANGELOG.md
                     docs/*.md
                     docs/design/*.md
                     docs/evidence/*.json
                     docs/superpowers/plans/*.md
extra-source-files:  runtime-cbits/*.c
                     runtime-test/*.py
                     test/native/*.sh
                     test/fixtures/**/*.bash
                     test/fixtures/**/*.fish
                     test/fixtures/**/*.args
                     test/fixtures/**/*.stdin
                     test/fixtures/**/*.mode
                     test/fixtures/**/*.prereqs
                     test/fixtures/**/*.platforms
                     test/fixtures/**/*.recursive
                     test/fixtures/**/*.md
                     test/fixtures/*.tsv
                     test/compile-fail/*.hs
                     benchmark/fixtures/*.bash
                     scripts/*.sh
                     scripts/*.py
                     scripts/*.txt
                     .github/workflows/ci.yml
tested-with:         GHC == {9.12.2, 9.14.1}

source-repository head
  type:                git
  location:            https://github.com/eessmann/monk.git

flag development
  description:         Treat warnings as errors during development and CI.
  default:             False
  manual:              True

common common-options
  build-depends:       base >= 4.21 && <5
                     , relude ^>= 1.2.2
                     , ShellCheck ^>= 0.11
                     , prettyprinter ^>= 1.7
                     , extra ^>= 1.8
                     , safe-exceptions ^>= 0.1.7
                     , mtl ^>= 2.3

  -- Use relude as the Prelude via mixins.
  mixins:              base hiding (Prelude)
                     , relude (Relude as Prelude)
                     , relude
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Winvalid-haddock
                       -Wredundant-bang-patterns
                       -Woperator-whitespace
                       -Wredundant-strictness-flags
                       -Wterm-variable-capture
                       -Winconsistent-flags

  if flag(development)
    ghc-options:       -Werror

  default-language:    GHC2024
  default-extensions:  ApplicativeDo
                       DefaultSignatures
                       FunctionalDependencies
                       MultiWayIf
                       OverloadedStrings
                       PartialTypeSignatures
                       RecordWildCards
                       TypeFamilies
                       ViewPatterns

library
  import:              common-options
  hs-source-dirs:      src
  exposed-modules:     Monk
                     , Monk.AST
                     , Monk.Source
                     , Monk.Translation
                     , Monk.Translation.Types
                     , Language.Fish.DSL
                     , Monk.Diagnostics
                     , Monk.Output
  build-depends:       monk:monk-runtime-core
                     , process ^>= 1.6
                     , containers >= 0.7 && < 0.9
                     , aeson ^>= 2.2
                     , bytestring ^>= 0.12
                     , text ^>= 2.1
                     , unix >= 2.8 && < 2.9
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
  other-modules:       Language.Fish.Translator.NativeRuntime
                     , Language.Fish.Translator.Statistics
                     , Language.Fish.Translator.Directory
                     , Monk.Output.Runtime
                     , Language.Fish.AST
                     , Language.Bash.Plan
                     , Language.Bash.Plan.Effects
                     , Language.Bash.Plan.Normalize
                     , Language.Bash.Plan.Directory
                     , Language.Fish.Translator.Binding
                     , Language.Fish.Translator.Child
                     , Language.Fish.Translator.Pattern
                     , Language.Fish.Translator.Plan
                     , Language.Bash.Arithmetic.Plan
                     , Language.Bash.Arithmetic.Source
                     , Language.Fish.Translator.ArithmeticPlan
                     , Language.Fish.Translator.ArithmeticDiagnostic
                     , Monk.Translation.Contract
                     , Monk.Translation.ParseDiagnostics
                     , Monk.Source.Environment
                     , Monk.Source.Product
                     , Monk.Output.Publication
                     , Language.Fish.AST.Common
                     , Language.Fish.AST.Example
                     , Language.Fish.AST.Types
                     , Language.Fish.DSL.Internal
                     , Language.Fish.DSL.Lower
                     , Language.Fish.DSL.Types

                     , Language.Fish.Pretty
                     , Language.Fish.Pretty.Command
                     , Language.Fish.Pretty.Expr
                     , Language.Fish.Pretty.Job
                     , Language.Fish.Pretty.Pattern
                     , Language.Fish.Pretty.Redirect
                     , Language.Fish.Pretty.Statement

                     , Language.Bash.Parser

library monk-harness-support
  import:              common-options
  visibility:          private
  hs-source-dirs:      src
  exposed-modules:     Monk.Internal.Fixture
                     , Monk.Internal.Shell
  build-depends:       aeson ^>= 2.2
                     , containers >= 0.7 && < 0.9
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , process ^>= 1.6
library monk-bakeoff-lib
  import:              common-options
  visibility:          private
  hs-source-dirs:      scripts
  exposed-modules:     Bakeoff.Fixture
                     , Bakeoff.Artifacts
                     , Bakeoff.Benchmark
                     , Bakeoff.Execution
                     , Bakeoff.Execution.Runtime
                     , Bakeoff.Process
                     , Bakeoff.Report
                     , Bakeoff.Runner
                     , Bakeoff.Selection
                     , Bakeoff.Shell
                     , Bakeoff.Tools
                     , Bakeoff.Types
  other-modules:       Bakeoff.Execution.Diff
                     , Bakeoff.Execution.Shared
                     , Bakeoff.Execution.Translation
  build-depends:       monk
                     , monk:monk-harness-support
                     , aeson ^>= 2.2
                     , bytestring ^>= 0.12
                     , containers >= 0.7 && < 0.9
                     , filepath ^>= 1.5
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , process ^>= 1.6
                     , shake ^>= 0.19
                     , time >= 1.14 && < 1.16
executable monk
  import:              common-options
  hs-source-dirs:      app
  main-is:             Main.hs
  build-depends:       monk
                     , optparse-applicative ^>= 0.19
                     , containers >= 0.7 && < 0.9
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
                     , text ^>= 2.1
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N

executable monk-bakeoff
  import:              common-options
  hs-source-dirs:      scripts/app
  main-is:             Main.hs
  build-depends:       monk
                     , monk:monk-bakeoff-lib
                     , optparse-applicative ^>= 0.19
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , time >= 1.14 && < 1.16
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N

test-suite monk-test
  import:              common-options
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             Spec.hs
  build-tool-depends:   monk:monk-runtime
  other-modules:       Gen
                     , Unit.API04
                     , FixtureAdmission
                     , FixtureSupport
                     , TestSupport
                     , SourceTestSupport
                     , ShellSupport
                     , RealWorld
                     , Golden
                     , Integration
                     , Unit.Inline
                     , Unit.OutputBundle
                     , Unit.Bakeoff
                     , Unit.Diagnostics
                     , Unit.DSL
                     , Unit.Harness
                     , Unit.TranslatorMonad
                     , Unit.Pipefail
                     , Unit.Pretty
                     , Unit.Refactor
                     , Unit.SemanticAdmission
                     , Unit.PlannedWordContexts
                     , Unit.PlannedCommonCoverage
                     , Unit.PlannedDirectory
                     , Unit.PlannedPrimitives
                     , Unit.PlannedRedirects
                     , Unit.PlannedArithmetic
                     , Unit.PlannedEnvironment
                     , Unit.PlannedFlowFacts
                     , Unit.PlannedIsolation
                     , Unit.PlannedSourceable
                     , Unit.Contract
                     , Unit.Source
                     , Unit.SourceResolution
                     , Unit.Translation
                     , Property.Pretty
                     , Property.AdmittedCompositions
                     , Property.Translation
                     , Property.OutputEquivalence
  build-depends:       monk
                     , aeson ^>= 2.2
                     , monk:monk-harness-support
                     , monk:monk-bakeoff-lib
                     , bytestring ^>= 0.12
                     , containers >= 0.7 && < 0.9
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
                     , path ^>= 0.9
                     , path-io ^>= 1.8
                     , process ^>= 1.6
                     , tasty ^>= 1.5
                     , temporary ^>= 1.3
                     , tasty-hunit ^>= 0.10
                     , tasty-quickcheck ^>= 0.11
                     , time >= 1.14 && < 1.16
                     , QuickCheck >= 2.14 && < 2.17

  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N

test-suite publication-test
  import:              common-options
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test src
  main-is:             PublicationSpec.hs
  other-modules:       Monk.Output.Publication
  build-tool-depends:   monk:monk-runtime
  build-depends:       bytestring ^>= 0.12
                     , monk:monk-runtime-core
                     , directory ^>= 1.3
                     , filepath ^>= 1.5
                     , text ^>= 2.1
                     , unix >= 2.8 && < 2.9
                     , tasty ^>= 1.5
                     , tasty-hunit ^>= 0.10
  ghc-options:         -threaded -rtsopts

benchmark monk-benchmark
  import:              common-options
  type:                exitcode-stdio-1.0
  hs-source-dirs:      benchmark
  main-is:             Main.hs
  build-depends:       monk
                     , criterion ^>= 1.6
                     , deepseq ^>= 1.5
                     , text ^>= 2.1
  ghc-options:         -threaded
                       -rtsopts
                       -with-rtsopts=-N


library monk-runtime-core
  visibility:          private
  hs-source-dirs:      runtime-src
  c-sources:          runtime-cbits/descriptors.c
  exposed-modules:     Monk.Runtime.Descriptors
                     , Monk.Runtime.Digest
                     , Monk.Runtime.Protocol
                     , Monk.Runtime.Integer
                     , Monk.Runtime.Fields
                     , Monk.Runtime.Pattern
                     , Monk.Runtime.Compatibility
                     , Monk.Runtime.Directory
                     , Monk.Runtime.Child
  default-language:   GHC2024
  build-depends:       base >=4.21 && <5
                     , bytestring ^>=0.12
                     , unix >=2.8 && <2.9
                     , process ^>=1.6
                     , containers >=0.7 && <0.9
                     , array >=0.5 && <0.6
                     , directory ^>=1.3
  ghc-options:         -Wall
  if flag(development)
    ghc-options:       -Werror

executable monk-runtime
  hs-source-dirs:      runtime-app
  main-is:             Main.hs
  default-language:   GHC2024
  build-depends:       base >=4.21 && <5
                     , monk:monk-runtime-core
                     , bytestring ^>=0.12
                     , unix >=2.8 && <2.9
  ghc-options:         -Wall -rtsopts=ignoreAll
  if flag(development)
    ghc-options:       -Werror


test-suite runtime-test
  type:                exitcode-stdio-1.0
  hs-source-dirs:      runtime-test
  main-is:             Main.hs
  default-language:   GHC2024
  build-depends:       base >=4.21 && <5
                     , monk:monk-runtime-core
                     , bytestring ^>=0.12
  ghc-options:         -Wall
  if flag(development)
    ghc-options:       -Werror
