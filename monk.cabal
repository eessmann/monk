cabal-version:       3.14
name:                monk
version:             0.4.0
synopsis:            Side-project Bash-to-fish translator.
description:
    Monk is a Haskell project for translating Bash scripts into fish.
    It admits an exact core under a versioned execution contract and rejects
    unsupported semantics before producing executable output. See [README.md](https://github.com/eessmann/monk#monk)
    for more details.
homepage:            https://github.com/eessmann/monk
bug-reports:         https://github.com/eessmann/monk/issues
license:             MIT
license-file:        LICENSE
author:              Erich Essmann
maintainer:          Erich Essmann <essmanne@gmail.com>
copyright:           2025 Erich Essmann
category:            Translate Bash to Fish shell
build-type:          Simple
extra-doc-files:     README.md
                     CHANGELOG.md
                     docs/*.md
                     docs/design/*.md
                     docs/evidence/*.json
                     docs/superpowers/plans/*.md
extra-source-files:  cabal.project
                     Cargo.toml
                     Cargo.lock
                     rust-toolchain.toml
                     .cargo/config.toml
                     runtime/Cargo.toml
                     runtime/src/*.rs
                     runtime/src/**/*.rs
                     runtime/tests/*.rs
                     runtime/tests/**/*.rs
                     runtime/tests/**/*.stderr
                     protocol/abi2.tsv
                     devenv.nix
                     devenv.yaml
                     devenv.lock
                     nix/*.nix
                     nix/*.md
                     test/native/*.sh
                     test/fixtures/**/*.bash
                     test/fixtures/**/*.fish
                     test/fixtures/**/*.json
                     test/fixtures/**/*.args
                     test/fixtures/**/*.stdin
                     test/fixtures/**/*.mode
                     test/fixtures/**/*.prereqs
                     test/fixtures/**/*.platforms
                     test/fixtures/**/*.recursive
                     test/fixtures/**/*.md
                     test/fixtures/*.tsv
                     test/compile-fail/*.hs
                     benchmark/fixtures/*.bash
                     test/evidence/*.json
                     test/evidence/*.md
                     test/evidence/frozen95/*.bash
                     scripts/*.hs
                     scripts/*.sh
                     scripts/*.txt
                     .github/workflows/ci.yml
tested-with:         GHC == {9.12.2, 9.14.1}

source-repository head
  type:                git
  location:            https://github.com/eessmann/monk.git

flag development
  description:         Treat warnings as errors during development and CI.
  default:             False
  manual:              True

common warnings
  ghc-options:         -Wall
                       -Wcompat
                       -Widentities
                       -Wincomplete-uni-patterns
                       -Wincomplete-record-updates
                       -Wredundant-constraints
                       -Wnoncanonical-monad-instances
                       -fhide-source-paths
                       -Wmissing-export-lists
                       -Wpartial-fields
                       -Wmissing-deriving-strategies
                       -fwrite-ide-info
                       -hiedir=.hie
                       -Winvalid-haddock
                       -Wredundant-bang-patterns
                       -Woperator-whitespace
                       -Wredundant-strictness-flags
                       -Wterm-variable-capture
                       -Winconsistent-flags

  if flag(development)
    ghc-options:       -Werror

common common-options
  import:              warnings
  build-depends:       base >= 4.21 && <5
                     , relude ^>= 1.2.2

  -- Use relude as the Prelude via mixins.
  mixins:              base hiding (Prelude)
                     , relude (Relude as Prelude)
                     , relude
  default-language:    GHC2024
  default-extensions:  ApplicativeDo
                       DefaultSignatures
                       FunctionalDependencies
                       MultiWayIf
                       OverloadedStrings
                       PartialTypeSignatures
                       RecordWildCards
                       TypeFamilies
                       ViewPatterns

library
  import:              common-options
  hs-source-dirs:      src
  exposed-modules:     Monk
                     , Monk.AST
                     , Monk.Source
                     , Monk.Translation
                     , Monk.Diagnostics
                     , Monk.Output
  reexported-modules:  Monk.Translation.Types
                     , Language.Fish.DSL
  other-modules:       Monk.Source.Product
                     , Monk.Translation.Parser
  build-depends:       monk:monk-foundation
                     , monk:monk-host
                     , monk:monk-compiler
                     , monk:monk-publication
                     , ShellCheck ^>= 0.11
                     , containers >= 0.7 && < 0.9
                     , bytestring ^>= 0.12
                     , text ^>= 2.1
                     , directory ^>= 1.3
                     , filepath ^>= 1.5

library monk-foundation
  import:              warnings
  default-language:    GHC2024
  default-extensions:  OverloadedStrings
  visibility:          private
  hs-source-dirs:      foundation-src
  exposed-modules:     Monk.Runtime.Abi2
                     , Monk.Runtime.Digest
                     , Monk.Runtime.Integer
                     , Monk.Runtime.NativeTarget
                     , Monk.Source.Location
                     , Monk.Translation.Contract
                     , Monk.Translation.Types
  build-depends:       base >=4.21 && <5
                     , cryptohash-sha256 ^>=0.11.102
                     , relude ^>=1.2.2
                     , aeson ^>=2.2
                     , containers >=0.7 && <0.9
                     , text ^>=2.1
                     , bytestring ^>=0.12

library monk-host
  import:              common-options
  visibility:          private
  hs-source-dirs:      host-src
  exposed-modules:     Monk.Host.Process
                     , Monk.Output.Runtime
                     , Monk.Runtime.Compatibility
                     , Monk.Source.Environment
  build-depends:       monk:monk-foundation
                     , async ^>=2.2
                     , stm ^>=2.5
                     , bytestring ^>=0.12
                     , containers >=0.7 && <0.9
                     , directory ^>=1.3
                     , filepath ^>=1.5
                     , process ^>=1.6
                     , text ^>=2.1
                     , unix >=2.8 && <2.9

