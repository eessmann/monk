                     , Language.Fish.Translator.Statistics
                     , Language.Fish.Translator.Traps
                     , Language.Fish.Translator.Words
                     , Monk.Compiler.Artifact
                     , Monk.Compiler.Context
                     , Monk.Compiler.Index
                     , Monk.Translation.ParseDiagnostics
  build-depends:       monk:monk-foundation
                     , singletons ^>=3.0
                     , ShellCheck ^>=0.11
                     , prettyprinter ^>=1.7
                     , mtl ^>=2.3
                     , containers >=0.7 && <0.9
                     , bytestring ^>=0.12
                     , text ^>=2.1
                     , filepath ^>=1.5

library monk-publication
  import:              common-options
  visibility:          private
  hs-source-dirs:      publication-src
  exposed-modules:     Monk.Output.Publication
                     , Monk.Output.Publication.Lock
                     , Monk.Output.Publication.Manifest
                     , Monk.Output.Publication.Plan
