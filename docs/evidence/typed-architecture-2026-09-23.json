  "type_and_effect_scope": {
    "enforced": [
      "Nominal compilation context and entry owner/contract at complete-plan sealing; private whole-artifact materialization/admission authority.",
      "Retained lexical control scopes and finite body roles at statement construction and consumers; loop/return/argv witnesses cannot cross their indexed scope.",
      "Opaque current-world dense proof/update applied atomically after operand normalization; definition identities have closed source/import/absent cases.",
      "Closed canonical Fish grammar/cardinality constraints and validated variable/executable identities; immutable Emission/Region keeps required definitions with consumers.",
      "Opcode-indexed complete session/primitive requests and Rust validated whole-request/pipeline decoding before effects.",
      "Rust owned/borrowed/consumed capabilities, cached completion and shared capture buffers; session guardian and private job leases preserve cleanup/lifetime."
    ],
    "limits": [
      "Nested existential semantic bodies carry lexical scope and finite role, not a separate compilation-owner index on every payload.",
      "Finite effect analysis is conservative data over the authoritative semantic plan. Native eligibility binds the proved statement but does not encode every effect dimension in every public Fish type.",
      "Types do not prove shell equivalence, host cancellation, publication concurrency or cross-platform behavior; those retain explicit runtime validation and execution tests.",
      "Publication ownership includes runtime leases to reject deferred/concurrent effects after lock scope; rank-n types alone do not prevent captured IO escape."
    ]
  },
  "dependency_exception": {
    "dependency": "typed-process",
    "resolution": "Resolved on both GHC lanes, then omitted after lifecycle feasibility failure.",
    "reason": "Its waiter can reap a fast leader before public getPid captures process-group identity; no public pre-wait hook or adopt-precreated-process API.",
    "replacement": "Shared narrow createProcess acquisition captures group identity before waiters, with bracketed async streams and a nonthreaded polling path. No wrapper process or unused dependency.",
    "decision": "docs/superpowers/plans/2026-09-23-typed-architecture.md#feasibility-ruling-during-implementation"
  },
